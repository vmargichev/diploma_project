SECRET_KEY=local-development-only-change-before-deployment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=learnuniverse_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_SITE_URL=http://127.0.0.1:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
FROM_EMAIL=noreply@learnuniverse.local
# Optional for payment testing; not required for learning features.
STRIPE_SECRET_KEY=
# To enable real password-reset delivery, replace the console EMAIL_BACKEND above with:
# EMAIL_BACKEND=anymail.backends.mailgun.EmailBackend
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=
# US region; use https://api.eu.mailgun.net/v3 for an EU domain.
MAILGUN_API_URL=https://api.mailgun.net/v3
# FROM_EMAIL above must use your verified Mailgun sending domain.
